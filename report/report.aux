\@writefile{toc}{\contentsline {section}{\numberline {B}Figures}{13}{appendix.B}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Six-stage MatrixInvLLM pipeline. (1) Generate stable $2 \times 2$ and $3 \times 3$ matrices with determinant ($|\det A| > 0.05$) and condition number ($\kappa < 50$) filters; 500 examples per size. (2) Serialize to deterministic text format with 5-decimal precision. (3) Split 1{,}000 examples into 800 train / 100 val / 100 test. (4) Evaluate untrained Llama-3.2-3B baseline on 100 test examples. (5) Apply LoRA fine-tuning ($r{=}16$, $\alpha {=}32$, 800 steps) on training set. (6) Re-evaluate fine-tuned model using a three-level diagnostic suite: syntactic well-formedness, coarse numeric structure, and residual-based inverse correctness.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{14}{Six-stage MatrixInvLLM pipeline. (1) Generate stable $2 \times 2$ and $3 \times 3$ matrices with determinant ($|\det A| > 0.05$) and condition number ($\kappa < 50$) filters; 500 examples per size. (2) Serialize to deterministic text format with 5-decimal precision. (3) Split 1{,}000 examples into 800 train / 100 val / 100 test. (4) Evaluate untrained Llama-3.2-3B baseline on 100 test examples. (5) Apply LoRA fine-tuning ($r{=}16$, $\alpha {=}32$, 800 steps) on training set. (6) Re-evaluate fine-tuned model using a three-level diagnostic suite: syntactic well-formedness, coarse numeric structure, and residual-based inverse correctness}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Top}: Three normalized metrics (all higher = better) comparing baseline and fine-tuned model. Parse/shape rate measures generation reliability; sign agreement and determinant ratio ($\times 100$ for scale) measure inverse-like coarse structure among parseable outputs. Fine-tuning improves both structural metrics---sign agreement rises from 50.3\% to 79.5\%, determinant ratio from 4.5\% to 63.9\%---but reduces parse reliability by 40 percentage points. Additional diagnostics (residuals, relative Frobenius error, spectral error, copy distances) are in Table~\ref {tab:results}. \textbf  {Bottom}: Failure mode distribution for the fine-tuned model ($n = 100$ test examples). 60 outputs are parseable but numerically wrong; 22 loop until the token budget is exhausted; 18 produce malformed shapes; 0 achieve a successful inversion.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:results}{{2}{15}{\textbf {Top}: Three normalized metrics (all higher = better) comparing baseline and fine-tuned model. Parse/shape rate measures generation reliability; sign agreement and determinant ratio ($\times 100$ for scale) measure inverse-like coarse structure among parseable outputs. Fine-tuning improves both structural metrics---sign agreement rises from 50.3\% to 79.5\%, determinant ratio from 4.5\% to 63.9\%---but reduces parse reliability by 40 percentage points. Additional diagnostics (residuals, relative Frobenius error, spectral error, copy distances) are in Table~\ref {tab:results}. \textbf {Bottom}: Failure mode distribution for the fine-tuned model ($n = 100$ test examples). 60 outputs are parseable but numerically wrong; 22 loop until the token budget is exhausted; 18 produce malformed shapes; 0 achieve a successful inversion}{figure.2}{}}
